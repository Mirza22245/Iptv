# Required in every environment. Use a long random secret; never commit the real value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# PostgreSQL
DATABASE_URL=postgresql://lydia_app:change-me@localhost:5432/lydia
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=10
